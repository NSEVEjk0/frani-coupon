# frani-coupon — configuration
# Copy to .env and adjust. All values default to testnet2.

# Network. Must be testnet2. Do not point this at mainnet.
COUPON_NETWORK=testnet2

# Where the wallet keys and state live on disk.
COUPON_DATA_DIR=./wallet-data

# testnet2 wallet-api base URL.
COUPON_WALLET_API=https://wallet-api.unicity.network

# Public testnet2 oracle key (not a secret).
COUPON_ORACLE_KEY=sk_ddc3cfcc001e4a28ac3fad7407f99590

# Stable per-machine device id for the wallet-api session.
COUPON_DEVICE_ID=frani-coupon-1

# Optional @nametag to register on first run (leave blank to skip).
COUPON_NAMETAG=

# Directory where invoices are stored.
COUPON_DIR=./invoices
